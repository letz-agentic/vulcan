;; Babashka tasks (spec section 11). Each delegates to `clojure -M:cli`, so the
;; same code path is reachable from the REPL as `(vulcan.cli/-main "ingest" ..)`.
;;
;; `tools/bin` is prepended to PATH for every task: Quarto and vl-convert are
;; pinned into the project rather than taken from wherever the machine happens
;; to have them, which is what makes a render reproducible from a clean
;; checkout (spec section 10.5). Clay shells out to a bare `quarto`, so the
;; pinning has to happen here, on the way in.

{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    (def tools-bin (str (fs/absolutize "tools/bin")))
    (def jvm-opts ["-J--enable-native-access=ALL-UNNAMED"])

    (defn dotenv
      "Read `.env` into a map, if it exists.

      Secrets stay out of the repo and out of the process table: `.env` is
      gitignored, and the values are handed to the child through its
      environment rather than interpolated into a command line, where they
      would be visible to `ps` for every user on the machine."
      []
      (if (fs/exists? ".env")
        (into {}
              (for [line (str/split-lines (slurp ".env"))
                    :let  [line (str/trim line)]
                    :when (and (seq line)
                               (not (str/starts-with? line "#"))
                               (str/includes? line "="))
                    ;; bb.edn is EDN: regex literals are not readable here.
                    :let  [[k v] (str/split line (re-pattern "=") 2)]]
                [(str/trim k) (str/trim v)]))
        {}))

    (defn vulcan
      "Run a vulcan.cli task in a JVM with the pinned tools on PATH and any
      local secrets from `.env` in the environment."
      [& args]
      (let [{:keys [exit]}
            (babashka.process/shell
             {:extra-env (merge (dotenv)
                                {"PATH" (str tools-bin ":" (System/getenv "PATH"))})
              :continue  true}
             (str/join " " (concat ["clojure"] jvm-opts ["-M:cli"] (map str args))))]
        (when-not (zero? exit) (System/exit exit)))))

  check      {:doc  "Verify pinned tools, the DuckDB driver and the store schema"
              :task (vulcan "check")}

  migrate    {:doc  "Create or upgrade the store"
              :task (vulcan "migrate")}

  ingest     {:doc  "Ingest Trivy JSON reports: bb ingest reports/"
              :task (apply vulcan "ingest" *command-line-args*)}

  summary    {:doc  "Print the KPI summary for the current scope"
              :task (apply vulcan "summary" *command-line-args*)}

  enrich     {:doc  "Refresh EPSS/KEV/CIRCL data: bb enrich --max-age 7d [--offline]"
              :task (apply vulcan "enrich" *command-line-args*)}

  decisions  {:doc  "OpenVEX decisions: bb decisions import vex.json | export | list"
              :task (apply vulcan "decisions" *command-line-args*)}

  render     {:doc  "Render a notebook: bb render management/posture --profile revealjs"
              :task (apply vulcan "render" *command-line-args*)}

  report     {:doc  "Render notebooks across profiles: bb report --profiles html,pptx"
              :task (apply vulcan "report" *command-line-args*)}

  test       {:doc  "Run the test suite"
              :task (let [{:keys [exit]}
                          (babashka.process/shell
                           {:extra-env {"PATH" (str tools-bin ":" (System/getenv "PATH"))}
                            :continue true}
                           "clojure -J--enable-native-access=ALL-UNNAMED -M:test")]
                      (System/exit exit))}

  fixtures   {:doc  "Regenerate test fixtures from data/raw/"
              :task (babashka.process/shell
                     "clojure -J--enable-native-access=ALL-UNNAMED -M:dev -e (require,'fixtures)(fixtures/-main)")}

  new-notebook
  {:doc  "Copy a template: bb new-notebook management/q3-review --kind slides"
   :task (let [[target & flags] *command-line-args*
               slides? (some #{"--kind" "slides"} flags)
               kind    (if (some #{"slides"} flags) "slides" "report")
               src     (str "notebooks/_template_" kind ".clj")
               dest    (str "notebooks/" (str/replace target "." "/") ".clj")
               ns-sym  (-> target (str/replace "/" ".") (str/replace "_" "-"))]
           (when-not target
             (println "usage: bb new-notebook <group/name> [--kind slides]")
             (System/exit 1))
           (when (fs/exists? dest)
             (println dest "already exists")
             (System/exit 1))
           (fs/create-dirs (fs/parent dest))
           (spit dest
                 (-> (slurp src)
                     (str/replace (str "_template-" kind) ns-sym)
                     (str/replace "Report title" target)
                     (str/replace "Deck title" target)))
           (println "created" dest)
           (when slides? nil))}}}
