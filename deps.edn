{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure                    {:mvn/version "1.12.3"}

  ;; --- store -------------------------------------------------------------
  org.duckdb/duckdb_jdbc                 {:mvn/version "1.5.5.1"}
  com.github.seancorfield/next.jdbc      {:mvn/version "1.3.1118"}
  com.github.seancorfield/honeysql       {:mvn/version "2.7.1437"}

  ;; --- data --------------------------------------------------------------
  metosin/jsonista                       {:mvn/version "0.3.13"}
  metosin/malli                          {:mvn/version "0.20.1"}
  scicloj/tablecloth                     {:mvn/version "8.024"}
  techascent/tech.ml.dataset.sql         {:mvn/version "7.029"}

  ;; --- enrichment --------------------------------------------------------
  hato/hato                              {:mvn/version "1.0.0"}

  ;; --- process / cli -----------------------------------------------------
  babashka/process                       {:mvn/version "0.6.23"}
  org.clojure/tools.cli                  {:mvn/version "1.4.256"}
  org.clojure/tools.logging              {:mvn/version "1.3.1"}
  ch.qos.logback/logback-classic         {:mvn/version "1.5.19"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "notebooks" "test"]
   :extra-deps  {org.scicloj/clay      {:mvn/version "2.0.21"}
                 org.scicloj/tableplot {:mvn/version "1-beta17"}}}

  :notebooks
  {:extra-paths ["notebooks"]
   :extra-deps  {org.scicloj/clay      {:mvn/version "2.0.21"}
                 org.scicloj/tableplot {:mvn/version "1-beta17"}}}

  :test
  {:extra-paths ["test" "notebooks"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                 lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                 org.scicloj/clay       {:mvn/version "2.0.21"}
                 org.scicloj/tableplot  {:mvn/version "1-beta17"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :cli
  {:extra-paths ["notebooks"]
   :extra-deps  {org.scicloj/clay      {:mvn/version "2.0.21"}
                 org.scicloj/tableplot {:mvn/version "1-beta17"}}
   :main-opts   ["-m" "vulcan.cli"]}}}
